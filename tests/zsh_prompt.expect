set timeout 5
set env(TERM) xterm
set env(KEYMENU_CONFIG) [lindex $argv 1]
set binary [lindex $argv 0]
spawn zsh -f
send -- "PS1='KEYMENU_PROMPT:%?>'; eval \"\$($binary shell zsh)\"\r"
expect "KEYMENU_PROMPT:0>"
send -- "K"
expect {
    "interactive use requires stdin and stderr to be terminals" { exit 1 }
    "keymenu" {}
    timeout { exit 1 }
}
send -- "f"
expect {
    "KEYMENU_PROMPT:7>" { exit 0 }
    timeout { exit 1 }
}
