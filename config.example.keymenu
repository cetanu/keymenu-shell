# A deliberately dense example for exercising large menus.
#
# The root menu contains one group for every letter. Each group contains
# twelve bindings so both the root and nested screens have many rows.
# Descriptions intentionally vary in length to exercise column alignment.

keybind("0", "Run the dense example smoke test", "echo keymenu stress test")
keybind(":", "echo strange")

group("a", "Application workflows")
group("b", "Build, test, and release")
group("c", "Containers and local services")
group("d", "Documentation and notes")
group("e", "Environment and credentials")
group("f", "Files and directories")
group("g", "Git and repository workflows")
group("h", "Host and system information")
group("i", "Issue tracking and triage")
group("j", "Jobs and background tasks")
group("k", "Kubernetes and clusters")
group("l", "Logs and observability")
group("m", "Media and screenshots")
group("n", "Network diagnostics")
group("o", "Operations and deployments")
group("p", "Projects and workspaces")
group("q", "Queues and message brokers")
group("r", "Runtime and processes")
group("s", "Search and navigation")
group("t", "Terminal utilities")
group("u", "User and account tasks")
group("v", "Virtual environments")
group("w", "Web and API tools")
group("x", "Experimental commands")
group("y", "Your personal shortcuts")
group("z", "Archives and compression")
group("1")

