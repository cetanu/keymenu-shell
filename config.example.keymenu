# A deliberately dense example for exercising large menus.
#
# The root menu contains a handful of broad groups. Each group contains
# nested categories, and each category contains twelve bindings so the
# example exercises several levels of navigation.
# Descriptions intentionally vary in length to exercise column alignment.

# Bare Group
group("a")

# Bare keybind
keybind("z")

# Bare keybind, positional
keybind("a1", "one", "echo a1")

# Keybind, description key
keybind("a2", description: "two", "echo a2")

# Keybind, command key
keybind("a3", "three", command: "echo a3")

# Keybind, description and command keys
keybind("a4", description: "four", command: "echo a4")


# Nested group and keybind
group("b", "First Level")
keybind("b1", "echo 1")

group("b2", "Second Level")
keybind("b21", "echo 2")

group("b22", "Third Level")
keybind("b221", "echo 3")

group("b222", "Fourth Level")
keybind("b2221", "echo 4")

# Implicit group
keybind("c1", "echo 1")
keybind("c2", "echo 2")
keybind("c3", "echo 3")
keybind("c4", "echo 4")

# Implicit nested group
keybind("cc1", "echo 5")
keybind("cc2", "echo 6")
keybind("cc3", "echo 7")
keybind("cc4", "echo 8")

# --- Following do not display because empty 

# Empty Group
group("d", "example")

# Empty Group, description key
group("e", description: "example")

# Nested empty groups
group("f")
group("f1")
group("f11")
group("f111")
