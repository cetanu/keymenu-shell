# Prefixes can be named so the root menu stays memorable.
group("g", "Git")

keybind("gs", "Status", "git status")
keybind("gl", "Recent log", "git log --oneline --decorate -20")

keybind("f", "List files", "ls -la")
keybind("r", "Reload shell", "exec $SHELL -l")

keybind("hw", "echo Hello World")
keybind("hb", "echo Hello Bob")

group("1", "Numbered")
keybind("11", "echo first")
keybind("12", "echo second")
keybind("13", "echo third")
keybind("14", "echo fourth")

keybind(":", "echo strange")
