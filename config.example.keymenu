# A deliberately dense example for exercising large menus.
#
# The root menu contains a handful of broad groups. Each group contains
# nested categories, and each category contains twelve bindings so the
# example exercises several levels of navigation.
# Descriptions intentionally vary in length to exercise column alignment.

keybind("0", "Run the dense example smoke test", "echo keymenu stress test")
keybind(":", "echo strange")

group("a", "Applications and development")
group("aa", "Application workflows")
group("ab", "Build, test, and release")
group("ac", "Containers and local services")
group("ad", "Documentation and notes")
group("ae", "Environment and credentials")
group("b", "Systems and operations")
group("ba", "Files and directories")
group("bb", "Git and repository workflows")
group("bc", "Host and system information")
group("bd", "Issue tracking and triage")
group("be", "Jobs and background tasks")
group("c", "Infrastructure and observability")
group("ca", "Kubernetes and clusters")
group("cb", "Logs and observability")
group("cc", "Media and screenshots")
group("cd", "Network diagnostics")
group("ce", "Operations and deployments")
group("d", "Projects and terminal work")
group("da", "Projects and workspaces")
group("db", "Queues and message brokers")
group("dc", "Runtime and processes")
group("dd", "Search and navigation")
group("de", "Terminal utilities")
group("e", "Personal and miscellaneous")
group("ea", "User and account tasks")
group("eb", "Virtual environments")
group("ec", "Web and API tools")
group("ed", "Experimental commands")
group("ee", "Your personal shortcuts")
group("ef", "Archives and compression")
group("e1")

